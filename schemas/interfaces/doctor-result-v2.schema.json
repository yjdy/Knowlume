{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowlume.dev/schemas/interfaces/doctor-result-v2.schema.json",
  "title": "Knowlume doctor-result-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "healthy",
    "versions",
    "probes",
    "checks"
  ],
  "properties": {
    "report_version": {
      "const": 2
    },
    "healthy": {
      "type": "boolean"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "object_contract",
        "locator",
        "relation_schema",
        "interface",
        "projection",
        "parser",
        "tokenizer",
        "configuration",
        "transaction"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "object_contract": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "integer",
          "minimum": 1
        },
        "relation_schema": {
          "type": "integer",
          "minimum": 1
        },
        "interface": {
          "type": "integer",
          "minimum": 1
        },
        "projection": {
          "type": "integer",
          "minimum": 1
        },
        "parser": {
          "type": "integer",
          "minimum": 1
        },
        "tokenizer": {
          "type": "integer",
          "minimum": 1
        },
        "configuration": {
          "type": "integer",
          "minimum": 1
        },
        "transaction": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "vault",
          "sqlite",
          "git",
          "zotero"
        ]
      }
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "code",
          "message",
          "exit_code"
        ],
        "properties": {
          "name": {
            "enum": [
              "python",
              "package-assets",
              "vault",
              "sqlite",
              "git",
              "zotero"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "skipped",
              "unavailable",
              "failed"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        }
      }
    }
  }
}
