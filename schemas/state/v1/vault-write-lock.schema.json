{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowlume.dev/schemas/state/v1/vault-write-lock.schema.json",
  "title": "Knowlume vault write lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lock_version",
    "lock_name",
    "vault_id",
    "owner_token",
    "process_id",
    "acquired_at",
    "transaction_id"
  ],
  "properties": {
    "lock_version": { "const": 1 },
    "lock_name": { "const": "vault-write" },
    "vault_id": { "$ref": "#/$defs/vaultId" },
    "owner_token": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "process_id": { "type": "integer", "minimum": 1 },
    "acquired_at": { "type": "string", "format": "date-time" },
    "transaction_id": {
      "oneOf": [
        { "$ref": "#/$defs/transactionId" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "vaultId": {
      "type": "string",
      "pattern": "^vault_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "transactionId": {
      "type": "string",
      "pattern": "^txn_[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
